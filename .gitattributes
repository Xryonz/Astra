# Esta maquina roda com core.autocrlf=true, entao TODO arquivo de texto vira
# CRLF no checkout. Pra script de shell isso e fatal: o bash le o \r como parte
# do comando e o arquivo morre com "syntax error" ou "bad interpreter" — e o
# hook de seguranca falharia CALADO numa clonagem nova.
*.sh   text eol=lf
gradlew text eol=lf

# --- Barra de linguagens do GitHub ---
#
# O GitHub mede a barra por BYTES de codigo, e nao por arquivo. Os quatro .java
# de mobile-native/desktopApp/src/main/java somam ~163 mil linhas — mais que o
# projeto inteiro em Kotlin — e nao foram escritos por ninguem: sao as classes
# que o protoc gera a partir dos .proto do LiveKit (a conversa entre o app e o
# servidor de voz). O app COMPILA contra elas, entao apagar quebra a voz; o que
# elas nao devem e contar como codigo do projeto.
mobile-native/desktopApp/src/main/java/livekit/**  linguist-generated=true
mobile-native/desktopApp/src/main/java/logger/**   linguist-generated=true
