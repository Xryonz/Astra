# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ───────────────────────────────────────────
dist/
build/
*.tsbuildinfo
.turbo/
.next/
out/

# ── Coverage / cache ────────────────────────────────────────
coverage/
.vite/
.cache/
.nyc_output/

# ── Env / secrets (NUNCA commitar) ─────────────────────────
# Service account do Firebase (chave privada do FCM) — vive só no
# Railway (env FIREBASE_SERVICE_ACCOUNT) e nesta máquina.
*firebase-adminsdk*.json
# Keystore de release do Android + credenciais: perder = não atualizar
# mais o app; vazar = qualquer um assina como Astra. FAZER BACKUP fora
# do repo (drive/pendrive).
*.keystore
*.jks
apps/web/android/keystore.properties
# Config do app Firebase: não é segredo crítico, mas o repo é PÚBLICO —
# expor a API key convida abuso de quota. Clone novo: baixar de novo no
# console Firebase (ver apps/web/MOBILE.md).
apps/web/android/app/google-services.json
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Allow examples (sanitized, no secrets)
!.env.example

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── User-uploaded files (runtime data, não pertence ao repo) ─
apps/api/uploads/

# ── Bundle analyzer output ──────────────────────────────────
stats.html
dist/stats.html

# ── Playwright output ───────────────────────────────────────
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── IDE / editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Ferramenta de desenvolvimento: fica LOCAL ──────────────
# O repositório é público e leva só o PRODUTO — código, testes, build,
# README. Como se trabalha no produto (agente, skills, planos, anotações)
# não é do interesse de quem clona, incha o histórico, e às vezes carrega
# coisa que não devia ser lida por estranho.
.claude/
.agents/
.cursor/
.windsurf/
skills-lock.json
CLAUDE.md
AGENTS.md
*.notas.md

# ── Docs pessoais: checkpoints/runbooks locais, não publicar ─
docs/

# As anotações do código — o "porquê" de cada decisão. Ficam LOCAIS pela mesma
# regra de sempre: o repositório público leva o produto, não o caderno de quem
# o construiu. Quem clona tem o código e o histórico de commits.
anotações.md
anotacoes.md

# ── Medições: planilhas de perfilamento (RAM, fps, banda). São o
# rascunho de uma investigação, ficam obsoletas na semana seguinte, e
# a conclusão delas já vive no comentário do código que originaram.
memoria-*.csv
*.perf.csv
tools/astra-medicao*.csv

# ── OS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ── Lock files alternativos (manter só package-lock.json) ────
yarn.lock
pnpm-lock.yaml

# Config de deploy da Vercel: fica LOCAL, fora do GitHub (decisao do dono).
vercel.json
